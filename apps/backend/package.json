    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/serve-static": "^12.1.1",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/unidecode": "^1.1.0",
    "axios": "^1.21.1",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "express-basic-auth": "^1.2.1",
    "jsdom": "^31.0.1",
    "keyv": "^6.1.0",
    "multer": "^2.5.0",
    "puppeteer": "^25.18.1",
    "reflect-metadata": "^0.2.2",
